# Server
NODE_ENV=development
PORT=3000

# Storage
DATA_DIR=./data
DATABASE_URL=./data/research.db

# Ollama (Host-Service, NICHT im Compose)
# Lokal:                         http://localhost:11434
# Aus Container heraus (Win/Mac): http://host.docker.internal:11434
# Aus Container heraus (Linux):   http://host.docker.internal:11434  (mit extra_hosts host-gateway)
OLLAMA_BASE_URL=http://localhost:11434

# Datenquellen
SEC_USER_AGENT="Kafin Research <you@example.com>"
FMP_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Logging
LOG_LEVEL=info
